{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiveSubs",
  "version": "0.1.0",
  "identifier": "dev.lucasmoy.livesubs",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "overlay",
        "title": "LiveSubs",
        "url": "overlay.html",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "focus": false,
        "shadow": false,
        "width": 1200,
        "height": 220,
        "x": 0,
        "y": 0,
        "visible": false
      },
      {
        "label": "settings",
        "title": "LiveSubs — Configuración",
        "url": "index.html",
        "width": 720,
        "height": 860,
        "minWidth": 560,
        "minHeight": 520,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "resources": ["icons/tray.png"],
    "linux": {
      "deb": {
        "depends": ["pulseaudio-utils", "python3", "python3-venv"]
      }
    }
  }
}
