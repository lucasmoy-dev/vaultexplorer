{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vault Explorer",
  "version": "0.2.16",
  "identifier": "com.linux.vaultexplorer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vault Explorer",
        "width": 1040,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false,
        "transparent": true,
        "hiddenTitle": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["vaultexplorer"]
      },
      "mobile": [
        { "scheme": ["vaultexplorer"] }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "linux": {
      "deb": {
        "desktopTemplate": "vaultexplorer.desktop"
      },
      "rpm": {
        "desktopTemplate": "vaultexplorer.desktop"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
