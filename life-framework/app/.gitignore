# Rust build artifacts
target/
**/target/

# Node
node_modules/
**/node_modules/

# Frontend build output
dist/

# Tauri auto-generates capability schemas; the Android project itself is
# committed (it carries hand-added manifest bits: FileProvider + the
# install-packages permission the updater needs).
src-tauri/gen/schemas/

# Logs / OS
*.log
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# Env / secrets
.env
.env.*

# Android signing secrets — never commit
**/keystore.properties
*.jks
*.keystore
